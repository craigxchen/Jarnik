LIB "elim.lib";
option(redSB);
ring rr=32003,(r0,r1,r2,r3,r4,r5,r6,s0,s1,s2,s3,s4,s5,s6,u),dp;
ideal I=(1)*(r0^1-s0^1)+(1)*(r4^1-s4^1)+(1)*(r5^1-s5^1)+(1)*(r6^1-s6^1),(1)*(r0^2-s0^2)+(1)*(r4^2-s4^2)+(1)*(r5^2-s5^2)+(1)*(r6^2-s6^2),(1)*(r0^3-s0^3)+(1)*(r4^3-s4^3)+(1)*(r5^3-s5^3)+(1)*(r6^3-s6^3),(1)*(r1^1-s1^1)+(1)*(r2^1-s2^1)+(1)*(r4^1-s4^1)+(1)*(r5^1-s5^1),(1)*(r1^2-s1^2)+(1)*(r2^2-s2^2)+(1)*(r4^2-s4^2)+(1)*(r5^2-s5^2),(1)*(r1^3-s1^3)+(1)*(r2^3-s2^3)+(1)*(r4^3-s4^3)+(1)*(r5^3-s5^3),(1)*(r1^1-s1^1)+(1)*(r3^1-s3^1)+(1)*(r4^1-s4^1)+(1)*(r6^1-s6^1),(1)*(r1^2-s1^2)+(1)*(r3^2-s3^2)+(1)*(r4^2-s4^2)+(1)*(r6^2-s6^2),(1)*(r1^3-s1^3)+(1)*(r3^3-s3^3)+(1)*(r4^3-s4^3)+(1)*(r6^3-s6^3),1*(r0+s0)+1*(r1+s1)+1*(r2+s2)+1*(r3+s3)+1*(r4+s4)+1*(r5+s5)+1*(r6+s6),r0-s0-1,2202*r0+9326*r1+1034*r2+4180*r3+1932*r4+8118*r5+7365*r6+7738*s0+6220*s1+3440*s2+1538*s3+7994*s4+465*s5+6387*s6+7091,9953*r0+35*r1+7298*r2+4364*r3+3749*r4+9686*r5+1675*r6+5201*s0+502*s1+366*s2+417*s3+8871*s4+151*s5+6246*s6+3549,6916*r0+476*r1+8645*r2+3633*r3+7175*r4+8124*r5+9059*r6+3819*s0+5664*s1+3783*s2+3585*s3+7531*s4+4748*s5+353*s6+6819,u*(r0-s0)*(r1-s1)*(r2-s2)*(r3-s3)*(r4-s4)*(r5-s5)*(r6-s6)-1;
I=std(I);
print("before: dim="+string(dim(I)));
list F=r0-s0,r1-s1,r2-s2,r3-s3,r4-s4,r5-s5,r6-s6,r0-r1,s0-s1,r0-s1,s0-r1,r0-r2,s0-s2,r0-s2,s0-r2,r0-r3,s0-s3,r0-s3,s0-r3,r0-r4,s0-s4,r0-s4,s0-r4,r0-r5,s0-s5,r0-s5,s0-r5,r0-r6,s0-s6,r0-s6,s0-r6,r1-r2,s1-s2,r1-s2,s1-r2,r1-r3,s1-s3,r1-s3,s1-r3,r1-r4,s1-s4,r1-s4,s1-r4,r1-r5,s1-s5,r1-s5,s1-r5,r1-r6,s1-s6,r1-s6,s1-r6,r2-r3,s2-s3,r2-s3,s2-r3,r2-r4,s2-s4,r2-s4,s2-r4,r2-r5,s2-s5,r2-s5,s2-r5,r2-r6,s2-s6,r2-s6,s2-r6,r3-r4,s3-s4,r3-s4,s3-r4,r3-r5,s3-s5,r3-s5,s3-r5,r3-r6,s3-s6,r3-s6,s3-r6,r4-r5,s4-s5,r4-s5,s4-r5,r4-r6,s4-s6,r4-s6,s4-r6,r5-r6,s5-s6,r5-s6,s5-r6;
int j;
for(j=1;j<=size(F);j++){ I=sat(I,F[j]); I=std(I); if (deg(I[1])==0) {break;} }
print("after: dim="+string(dim(I))+" vdim="+string(vdim(I))+" one="+string(deg(I[1])==0));
if (deg(I[1])!=0 and dim(I)==0) { print(I); }
quit;
