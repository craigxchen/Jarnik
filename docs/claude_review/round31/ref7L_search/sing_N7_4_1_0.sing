LIB "elim.lib";
option(redSB);
ring rr=0,(r0,r1,r2,r3,r4,s0,s1,s2,s3,s4,u),dp;
ideal I=(2)*(r3^1-s3^1)+(2)*(r4^1-s4^1),(2)*(r3^2-s3^2)+(2)*(r4^2-s4^2),(2)*(r3^3-s3^3)+(2)*(r4^3-s4^3),(1)*(r1^1-s1^1)+(1)*(r2^1-s2^1)+(2)*(r4^1-s4^1),(1)*(r1^2-s1^2)+(1)*(r2^2-s2^2)+(2)*(r4^2-s4^2),(1)*(r1^3-s1^3)+(1)*(r2^3-s2^3)+(2)*(r4^3-s4^3),(1)*(r1^1-s1^1)+(1)*(r2^1-s2^1)+(2)*(r3^1-s3^1),(1)*(r1^2-s1^2)+(1)*(r2^2-s2^2)+(2)*(r3^2-s3^2),(1)*(r1^3-s1^3)+(1)*(r2^3-s2^3)+(2)*(r3^3-s3^3),(1)*(r0^1-s0^1)+(1)*(r2^1-s2^1)+(1)*(r3^1-s3^1)+(1)*(r4^1-s4^1),(1)*(r0^2-s0^2)+(1)*(r2^2-s2^2)+(1)*(r3^2-s3^2)+(1)*(r4^2-s4^2),(1)*(r0^3-s0^3)+(1)*(r2^3-s2^3)+(1)*(r3^3-s3^3)+(1)*(r4^3-s4^3),1*(r0+s0)+1*(r1+s1)+1*(r2+s2)+2*(r3+s3)+2*(r4+s4),r0-s0-1,u*(r0-s0)*(r1-s1)*(r2-s2)*(r3-s3)*(r4-s4)-1;
I=std(I);
print("before: dim="+string(dim(I)));
list F=r0-s0,r1-s1,r2-s2,r3-s3,r4-s4,r0-r1,s0-s1,r0-s1,s0-r1,r0-r2,s0-s2,r0-s2,s0-r2,r0-r3,s0-s3,r0-s3,s0-r3,r0-r4,s0-s4,r0-s4,s0-r4,r1-r2,s1-s2,r1-s2,s1-r2,r1-r3,s1-s3,r1-s3,s1-r3,r1-r4,s1-s4,r1-s4,s1-r4,r2-r3,s2-s3,r2-s3,s2-r3,r2-r4,s2-s4,r2-s4,s2-r4,r3-r4,s3-s4,r3-s4,s3-r4;
int j;
for(j=1;j<=size(F);j++){ I=sat(I,F[j]); I=std(I); if (deg(I[1])==0) {break;} }
print("after: dim="+string(dim(I))+" vdim="+string(vdim(I))+" one="+string(deg(I[1])==0));
if (deg(I[1])!=0 and dim(I)==0) { print(I); }
quit;
