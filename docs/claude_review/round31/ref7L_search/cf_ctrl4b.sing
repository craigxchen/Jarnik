int j;
for(j=1;j<=size(F);j++){ if (deg(I[1])==0) {break;} I=sat(I,F[j]); I=std(I); }
print(s0+"  after: dim="+string(dim(I))+" vdim="+string(vdim(I))+" one="+string(deg(I[1])==0));
quit;
