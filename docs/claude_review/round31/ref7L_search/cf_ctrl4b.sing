matrix C=coeffs(P,t); for(int m=1;m<4;m++){ if (4-m+1>=1) { I=I+C[4-m+1,1]; } } kill C; kill P; kill m;
poly P=(t^1+g1_1*t^0)*(t^1+g3_1*t^0)*(t^1+g5_1*t^0)*(t^1+g6_1*t^0)-(t^1+h1_1*t^0)*(t^1+h3_1*t^0)*(t^1+h5_1*t^0)*(t^1+h6_1*t^0);

