LIB "elim.lib";
option(redSB);
ring rr=32003,(t,g0_1,h0_1,g1_1,h1_1,g2_1,h2_1,g3_1,h3_1,g4_1,h4_1,g5_1,h5_1,g6_1,h6_1),dp;
