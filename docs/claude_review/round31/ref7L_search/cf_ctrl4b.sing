setring rr;
list F=resultant((t^1+g1_1*t^0),(t^1+h1_1*t^0),t),resultant((t^1+g2_1*t^0),(t^1+h2_1*t^0),t),resultant((t^1+g3_1*t^0),(t^1+h3_1*t^0),t),resultant((t^1+g4_1*t^0),(t^1+h4_1*t^0),t),resultant((t^1+g5_1*t^0),(t^1+h5_1*t^0),t),resultant((t^1+g6_1*t^0),(t^1+h6_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+g1_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+h1_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+h1_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+g1_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+g2_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+h2_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+h2_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+g2_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+g3_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+h3_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+h3_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+g3_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+g4_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+h4_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+h4_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+g4_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+g5_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+h5_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+h5_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+g5_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+g6_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+h6_1*t^0),t),resultant((t^1+g0_1*t^0),(t^1+h6_1*t^0),t),resultant((t^1+h0_1*t^0),(t^1+g6_1*t^0),t),resultant((t^1+g1_1*t^0),(t^1+g2_1*t^0),t),resultant((t^1+h1_1*t^0),(t^1+h2_1*t^0),t),resultant((t^1+g1_1*t^0),(t^1+h2_1*t^0),t),resultant((t^1+h1_1*t^0),(t^1+g2_1*t^0),t),resultant((t^1+g1_1*t^0),(t^1+g3_1*t^0),t),resultant((t^1+h1_1*t^0),(t^1+h3_1*t^0),t),resultant((t^1+g1_1*t^0),(t^1+h3_1*t^0),t),resultant((t^1+h1_1*t^0),(t^1+g3_1*t^0),t),resultant((t^1+g1_1*t^0),(t^1+g4_1*t^0),t),resultant((t^1+h1_1*t^0),(t^1+h4_1*t^0),t),resultant((t^1+g1_1*t^0),(t^1+h4_1*t^0),t),resultant((t^1+h1_1*t^0),(t^1+g4_1*t^0),t),resultant((t^1+g1_1*t^0),(t^1+g5_1*t^0),t),resultant((t^1+h1_1*t^0),(t^1+h5_1*t^0),t),resultant((t^1+g1_1*t^0),(t^1+h5_1*t^0),t),resultant((t^1+h1_1*t^0),(t^1+g5_1*t^0),t),resultant((t^1+