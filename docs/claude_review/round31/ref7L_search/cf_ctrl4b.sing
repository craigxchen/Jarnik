I=I+(9953*g0_1+35*h0_1+7298*g1_1+4364*h1_1+3749*g2_1+9686*h2_1+1675*g3_1+5201*h3_1+502*g4_1+366*h4_1+417*g5_1+8871*h5_1+151*g6_1+6246*h6_1+3549);
I=I+(6916*g0_1+476*h0_1+8645*g1_1+3633*h1_1+7175*g2_1+8124*h2_1+9059*g3_1+3819*h3_1+5664*g4_1+3783*h4_1+3585*g5_1+7531*h5_1+4748*g6_1+353*h6_1+6819);
ring r2=32003,(g0_1,h0_1,g1_1,h1_1,g2_1,h2_1,g3_1,h3_1,g4_1,h4_1,g5_1,h5_1,g6_1,h6_1),dp;
